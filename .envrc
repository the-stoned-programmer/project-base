# Direnv configuration for Modern Project Base
# Automatically loads when entering the project directory

export BACKEND_PORT=3001
export FRONTEND_PORT=5173
export VITE_API_URL="http://127.0.0.1:3001"
export RUST_LOG="info,modern_backend=debug"

# Ensure local binaries and cargo are in path
PATH_add scripts
PATH_add frontend/node_modules/.bin
